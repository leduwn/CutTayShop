@model (int CurrentPage, int TotalPages, string BaseUrl)

@if (Model.TotalPages > 1)
{
  <nav class="pagination-wrap" aria-label="Phân trang sản phẩm">
    @* Prev button *@
    @if (Model.CurrentPage > 1)
    {
      <a href="@($"{Model.BaseUrl}page={Model.CurrentPage - 1}")" class="page-btn" aria-label="Trang trước">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </a>
    }
    else
    {
      <span class="page-btn is-disabled" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </span>
    }

    @* Page numbers *@
    @for (int p = 1; p <= Model.TotalPages; p++)
    {
      if (p == Model.CurrentPage)
      {
        <span class="page-btn is-active" aria-current="page">@p</span>
      }
      else if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
      {
        <a href="@($"{Model.BaseUrl}page={p}")" class="page-btn">@p</a>
      }
      else if (p == 2 && Model.CurrentPage > 3 || p == Model.TotalPages - 1 && Model.CurrentPage < Model.TotalPages - 2)
      {
        <span class="page-btn is-disabled" style="border: none; background: transparent;">...</span>
      }
    }

    @* Next button *@
    @if (Model.CurrentPage < Model.TotalPages)
    {
      <a href="@($"{Model.BaseUrl}page={Model.CurrentPage + 1}")" class="page-btn" aria-label="Trang tiếp theo">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    }
    else
    {
      <span class="page-btn is-disabled" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </span>
    }
  </nav>
}
