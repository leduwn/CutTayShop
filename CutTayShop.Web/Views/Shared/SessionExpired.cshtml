@{
    ViewData["Title"] = "Phiên Làm Việc Hết Hạn — CutTayShop";
}

<div class="container-custom" style="padding-top: 64px; padding-bottom: 96px; text-align: center;">
  <div class="system-error-card" style="max-width: 600px; margin: 0 auto;">
    <div class="error-sticker" style="font-size: 5rem; line-height: 1; margin-bottom: 16px;">
      ⏳
    </div>
    <div class="badge-capsule badge-sky" style="margin-bottom: 16px;">
      Hết phiên làm việc
    </div>
    <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 12px; letter-spacing: -0.02em;">
      Phiên đăng nhập đã hết hạn
    </h1>
    <p style="color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: 32px;">
      Để bảo vệ an toàn cho tài khoản và dữ liệu giỏ hàng của bạn, phiên làm việc đã tự động đóng sau một khoảng thời gian không có tương tác.
    </p>

    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/dang-nhap" class="btn-pill btn-pill-primary btn-pill-lg">
        Đăng nhập lại →
      </a>
      <a href="/" class="btn-pill btn-pill-secondary btn-pill-lg">
        Về trang chủ
      </a>
    </div>
  </div>
</div>
