@model double
@{
    var rating = Math.Max(0, Math.Min(5, Model));
    var fullStars = (int)Math.Floor(rating);
    var hasHalf = (rating - fullStars) >= 0.3;
}

<div class="stars-group" style="display: inline-flex; align-items: center; gap: 2px; color: var(--color-warning);" aria-label="@rating.ToString("0.0") trên 5 sao">
  @for (int i = 1; i <= 5; i++)
  {
    if (i <= fullStars)
    {
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
    }
    else if (i == fullStars + 1 && hasHalf)
    {
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" opacity="0.4"></path>
        <path d="M12 2v15.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
      </svg>
    }
    else
    {
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
    }
  }
</div>
