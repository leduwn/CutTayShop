@model CatalogViewModel
@{
    var formAction = Model.IsSearch ? "/tim-kiem" : (Model.Category != null ? $"/danh-muc/{Model.Category.Slug}" : "/san-pham");
}

<div class="filter-drawer-backdrop" data-filter-drawer role="dialog" aria-modal="true" aria-label="Bộ lọc di động">
  <div class="filter-drawer-panel">
    <div class="drawer-header">
      <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--color-text-primary);">Bộ lọc sản phẩm</h3>
      <button type="button" class="btn-icon" data-filter-drawer-close aria-label="Đóng bộ lọc">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <form method="get" action="@formAction" class="drawer-body">
      @if (Model.IsSearch && !string.IsNullOrEmpty(Model.SearchQuery))
      {
        <input type="hidden" name="q" value="@Model.SearchQuery" />
      }
      <input type="hidden" name="sortBy" value="@Model.Filter.SortBy" />

      @* Categories (if not category page) *@
      @if (Model.Category == null)
      {
        <div class="filter-group">
          <h4 class="filter-group-title">Danh mục</h4>
          <div class="filter-options-list">
            @foreach (var cat in Model.Result.AvailableCategories)
            {
              var isChecked = Model.Filter.CategorySlug == cat.Slug;
              <label class="filter-checkbox-label">
                <span class="filter-checkbox-inner">
                  <input type="radio" name="categorySlug" value="@cat.Slug" class="filter-checkbox-input" checked="@(isChecked ? "checked" : null)" />
                  <span>@cat.Name</span>
                </span>
                <span class="filter-count-badge">(@cat.ProductCount)</span>
              </label>
            }
          </div>
        </div>
      }

      @* Price Range *@
      <div class="filter-group">
        <h4 class="filter-group-title">Khoảng giá (₫)</h4>
        <div class="price-inputs-row">
          <input type="number" name="minPrice" class="price-input" placeholder="Từ" value="@Model.Filter.MinPrice" step="50000" min="0" />
          <span style="color: var(--color-text-muted);">-</span>
          <input type="number" name="maxPrice" class="price-input" placeholder="Đến" value="@Model.Filter.MaxPrice" step="50000" min="0" />
        </div>
      </div>

      @* Brands *@
      @if (Model.Result.AvailableBrands.Count > 0)
      {
        <div class="filter-group">
          <h4 class="filter-group-title">Thương hiệu</h4>
          <div class="filter-options-list">
            @foreach (var brand in Model.Result.AvailableBrands)
            {
              var isChecked = Model.Filter.Brand == brand;
              <label class="filter-checkbox-label">
                <span class="filter-checkbox-inner">
                  <input type="radio" name="brand" value="@brand" class="filter-checkbox-input" checked="@(isChecked ? "checked" : null)" />
                  <span>@brand</span>
                </span>
              </label>
            }
          </div>
        </div>
      }

      @* Rating *@
      <div class="filter-group">
        <h4 class="filter-group-title">Đánh giá</h4>
        <div class="filter-options-list">
          @for (int r = 5; r >= 4; r--)
          {
            var isChecked = Model.Filter.MinRating == r;
            <label class="filter-checkbox-label">
              <span class="filter-checkbox-inner">
                <input type="radio" name="minRating" value="@r" class="filter-checkbox-input" checked="@(isChecked ? "checked" : null)" />
                <span style="display: flex; align-items: center; gap: 4px;">
                  <span style="color: var(--color-warning);">★</span>
                  <span>Từ @r sao</span>
                </span>
              </span>
            </label>
          }
        </div>
      </div>

      @* In Stock & On Sale *@
      <div class="filter-group">
        <h4 class="filter-group-title">Tình trạng</h4>
        <div class="filter-options-list">
          <label class="filter-checkbox-label">
            <span class="filter-checkbox-inner">
              <input type="checkbox" name="inStockOnly" value="true" class="filter-checkbox-input" checked="@(Model.Filter.InStockOnly == true ? "checked" : null)" />
              <span>Chỉ còn hàng</span>
            </span>
          </label>
          <label class="filter-checkbox-label">
            <span class="filter-checkbox-inner">
              <input type="checkbox" name="onSaleOnly" value="true" class="filter-checkbox-input" checked="@(Model.Filter.OnSaleOnly == true ? "checked" : null)" />
              <span style="color: var(--color-sale); font-weight: 600;">Đang giảm giá</span>
            </span>
          </label>
        </div>
      </div>

      <div class="drawer-footer">
        <a href="@formAction" class="btn-pill btn-pill-secondary" style="flex: 1; text-align: center;">Thiết lập lại</a>
        <button type="submit" class="btn-pill btn-pill-primary" style="flex: 2;">Áp dụng bộ lọc</button>
      </div>
    </form>
  </div>
</div>
