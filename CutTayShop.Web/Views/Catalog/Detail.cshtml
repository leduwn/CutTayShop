@model ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var p = Model.Product;
    var discount = p.DiscountPercent;
    var images = p.GalleryImages != null && p.GalleryImages.Count > 0
        ? p.GalleryImages
        : new List<string> { p.ImageUrl };
    var mainImg = images.First();
}

@section Styles {
  <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
}

<!-- Breadcrumbs -->
<partial name="_Breadcrumb" model="Model.Breadcrumbs" />

<div class="container-custom pdp-main-section">
  <!-- 1. Top Section: Gallery (Left) & Purchase Info (Right) -->
  <div class="pdp-grid">
    <!-- Left: Gallery -->
    <div class="pdp-gallery-wrap">
      <div class="pdp-gallery-main">
        @if (!string.IsNullOrEmpty(p.BadgeText))
        {
          <span class="badge-capsule badge-sale pdp-gallery-badge">@p.BadgeText</span>
        }
        <img src="@mainImg" alt="@p.Name" class="pdp-gallery-main-img" width="500" height="500" />
      </div>

      @if (images.Count > 1)
      {
        <div class="pdp-gallery-thumbs" role="tablist" aria-label="Hình ảnh sản phẩm">
          @for (int i = 0; i < images.Count; i++)
          {
            var img = images[i];
            var isActive = i == 0;
            <button type="button" class="pdp-thumb-btn @(isActive ? "is-active" : "")" data-img-src="@img" aria-label="Xem hình ảnh @(i + 1)">
              <img src="@img" alt="Thumbnail @(i + 1)" class="pdp-thumb-img" loading="lazy" />
            </button>
          }
        </div>
      }
    </div>

    <!-- Right: Purchase Info -->
    <div class="pdp-info-wrap">
      @if (!string.IsNullOrEmpty(p.Brand))
      {
        <span class="pdp-brand-tag">@p.Brand</span>
      }

      <h1 class="pdp-product-title">@p.Name</h1>

      <!-- Rating & Stock Status -->
      <div class="pdp-rating-strip">
        <div style="display: flex; align-items: center; gap: 6px;">
          <partial name="_RatingStars" model="p.Rating" />
          <span style="font-weight: 700; color: var(--color-text-primary);">@p.Rating.ToString("0.0")</span>
          <span style="color: var(--color-text-muted);">(@p.ReviewCount.ToString("N0") đánh giá)</span>
        </div>
        <span style="color: var(--color-border-strong);">|</span>
        <div class="pdp-stock-status">
          <span class="pdp-stock-dot"></span>
          <span>@(p.InStock ? "Còn hàng trong kho" : "Tạm hết hàng")</span>
        </div>
      </div>

      <!-- Price Box -->
      <div class="pdp-price-box">
        <span class="pdp-price-current">@p.Price.ToString("N0")₫</span>
        @if (p.OriginalPrice > p.Price)
        {
          <span class="pdp-price-original">@p.OriginalPrice.ToString("N0")₫</span>
          <span class="pdp-price-save-badge">Tiết kiệm @discount%</span>
        }
      </div>

      <!-- Short Description -->
      <p style="font-size: 0.9375rem; color: var(--color-text-secondary); line-height: 1.6;">
        @p.ShortDescription
      </p>

      <!-- Variants -->
      @if (p.Variants != null && p.Variants.Count > 0)
      {
        <div class="pdp-option-group">
          <label class="pdp-option-label">Lựa chọn phiên bản:</label>
          <div class="pdp-variants-list" role="radiogroup">
            @for (int i = 0; i < p.Variants.Count; i++)
            {
              var v = p.Variants[i];
              var isSelected = i == 0;
              <button type="button" class="pdp-variant-pill @(isSelected ? "is-selected" : "")" data-variant-price="@v.Price" role="radio" aria-checked="@(isSelected ? "true" : "false")">
                @v.Name
              </button>
            }
          </div>
        </div>
      }

      <!-- Quantity Stepper & Actions -->
      <div class="pdp-action-group">
        <div class="quantity-stepper" aria-label="Bộ chọn số lượng">
          <button type="button" class="stepper-btn" data-stepper-minus aria-label="Giảm số lượng">-</button>
          <input type="number" class="stepper-input" data-stepper-input value="1" min="1" max="99" aria-label="Số lượng" />
          <button type="button" class="stepper-btn" data-stepper-plus aria-label="Tăng số lượng">+</button>
        </div>

        <button type="button" class="btn-pill btn-pill-secondary btn-pill-lg"
                data-pdp-add-cart
                data-product-id="@p.Id"
                data-product-name="@p.Name"
                data-product-price="@p.Price"
                data-product-image="@p.ImageUrl"
                data-product-slug="@p.Slug">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Thêm vào giỏ hàng</span>
        </button>

        <button type="button" class="btn-pill btn-pill-primary btn-pill-lg"
                data-pdp-buy-now
                data-product-id="@p.Id"
                data-product-name="@p.Name"
                data-product-price="@p.Price"
                data-product-image="@p.ImageUrl"
                data-product-slug="@p.Slug">
          <span>Mua ngay</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <!-- Trust Commitments Box -->
      <div class="pdp-commitments">
        <div class="pdp-commitment-item">
          <span style="color: var(--color-primary); font-size: 1.125rem;">⚡</span>
          <span>Giao nhanh tiêu chuẩn toàn quốc</span>
        </div>
        <div class="pdp-commitment-item">
          <span style="color: var(--color-primary); font-size: 1.125rem;">🛡️</span>
          <span>Cam kết hàng chính hãng 100%</span>
        </div>
        <div class="pdp-commitment-item">
          <span style="color: var(--color-primary); font-size: 1.125rem;">🔄</span>
          <span>Đổi trả miễn phí trong 7 ngày</span>
        </div>
        <div class="pdp-commitment-item">
          <span style="color: var(--color-primary); font-size: 1.125rem;">🎁</span>
          <span>Đóng gói cẩn thận, bảo hành uy tín</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Middle Section: Tabs (Description, Specifications, Reviews) -->
  <div class="pdp-tabs-wrap">
    <div class="pdp-tabs-nav" role="tablist">
      <button type="button" class="pdp-tab-trigger is-active" data-tab-target="tab-desc" role="tab" aria-selected="true">Mô tả sản phẩm</button>
      <button type="button" class="pdp-tab-trigger" data-tab-target="tab-specs" role="tab" aria-selected="false">Thông số kỹ thuật</button>
      <button type="button" class="pdp-tab-trigger" data-tab-target="tab-reviews" role="tab" aria-selected="false">Đánh giá (@(p.Reviews?.Count ?? p.ReviewCount))</button>
    </div>

    <!-- Tab 1: Description -->
    <div id="tab-desc" class="pdp-tab-content is-active" role="tabpanel">
      <div style="max-width: 840px;">
        <p style="margin-bottom: 16px;">@p.Description</p>
        <p style="margin-bottom: 16px;">
          Sản phẩm được gia công và hoàn thiện với tiêu chuẩn khắt khe, mang lại trải nghiệm tối ưu cho nhu cầu sử dụng hàng ngày và thể hiện cá tính riêng biệt.
        </p>
        <h4 style="font-size: 1.125rem; font-weight: 700; color: var(--color-text-primary); margin: 24px 0 12px;">Đặc điểm nổi bật:</h4>
        <ul style="padding-left: 20px; display: flex; flex-direction: column; gap: 8px;">
          <li>Thiết kế hiện đại, phối màu pastel tinh tế theo xu hướng 2026.</li>
          <li>Chất lượng hoàn thiện cao cấp, bền bỉ theo thời gian.</li>
          <li>Tối ưu công thái học, đem lại cảm giác thoải mái tối đa khi sử dụng.</li>
        </ul>
      </div>
    </div>

    <!-- Tab 2: Specifications -->
    <div id="tab-specs" class="pdp-tab-content" role="tabpanel">
      @if (p.Specifications != null && p.Specifications.Count > 0)
      {
        <table class="specs-table">
          <tbody>
            @foreach (var spec in p.Specifications)
            {
              <tr>
                <td class="specs-label">@spec.Key</td>
                <td>@spec.Value</td>
              </tr>
            }
          </tbody>
        </table>
      }
      else
      {
        <p>Thông số kỹ thuật chi tiết đang được cập nhật.</p>
      }
    </div>

    <!-- Tab 3: Reviews -->
    <div id="tab-reviews" class="pdp-tab-content" role="tabpanel">
      @if (p.Reviews != null && p.Reviews.Count > 0)
      {
        <div class="reviews-grid">
          @foreach (var rev in p.Reviews)
          {
            <div class="review-card">
              <div class="review-header">
                <div>
                  <span class="review-author">@rev.AuthorName</span>
                  @if (rev.IsVerifiedPurchase)
                  {
                    <span class="review-verified">✓ Đã mua hàng</span>
                  }
                </div>
                <span class="review-date">@rev.Date.ToString("dd/MM/yyyy")</span>
              </div>
              <partial name="_RatingStars" model="@((double)rev.Rating)" />
              <p class="review-body">@rev.Comment</p>
            </div>
          }
        </div>
      }
      else
      {
        <p>Chưa có đánh giá nào cho sản phẩm này.</p>
      }
    </div>
  </div>

  <!-- 3. Bottom Section: Related Products -->
  @if (Model.RelatedProducts != null && Model.RelatedProducts.Count > 0)
  {
    <section class="products-section" aria-label="Sản phẩm tương tự">
      <div class="section-header">
        <div class="section-header-left">
          <h2 class="section-title">Sản phẩm liên quan</h2>
          <p class="section-subtitle">Có thể bạn cũng sẽ thích các sản phẩm này</p>
        </div>
      </div>
      <div class="deals-grid">
        @foreach (var related in Model.RelatedProducts)
        {
          <partial name="_ProductCard" model="related" />
        }
      </div>
    </section>
  }
</div>

<!-- Mobile Sticky Bar -->
<div class="pdp-mobile-sticky-bar">
  <div>
    <div style="font-size: 0.75rem; color: var(--color-text-muted);">Giá sản phẩm</div>
    <div style="font-size: 1.25rem; font-weight: 800; color: var(--color-sale);">@p.Price.ToString("N0")₫</div>
  </div>
  <button type="button" class="btn-pill btn-pill-primary"
          data-pdp-add-cart
          data-product-id="@p.Id"
          data-product-name="@p.Name"
          data-product-price="@p.Price"
          data-product-image="@p.ImageUrl"
          data-product-slug="@p.Slug">
    <span>Thêm vào giỏ</span>
    <span aria-hidden="true">→</span>
  </button>
</div>

@section Scripts {
  <script src="~/js/catalog.js" asp-append-version="true"></script>
}
