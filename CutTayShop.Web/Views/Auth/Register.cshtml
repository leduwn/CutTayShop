@model CutTayShop.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản Mới — CutTayShop";
}

<div class="container-custom" style="padding-top: 48px; padding-bottom: 80px; max-width: 480px;">
  <div class="auth-card">
    <div class="auth-card-header">
      <div class="badge-capsule badge-peach" style="margin-bottom: 12px;">Ưu đãi thành viên mới</div>
      <h1 class="auth-title">Tạo tài khoản CutTayShop</h1>
      <p class="auth-subtitle">Nhận ngay voucher 20.000đ và tích điểm nâng hạng thành viên</p>
    </div>

    <form asp-controller="AuthController" asp-action="Register" method="post">
      @Html.AntiForgeryToken()

      <div class="form-group" style="margin-bottom: 16px;">
        <label asp-for="FullName" class="form-label">Họ và tên <span class="required">*</span></label>
        <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
        <span asp-validation-for="FullName" class="field-validation-error"></span>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label asp-for="Email" class="form-label">Địa chỉ Email <span class="required">*</span></label>
        <input asp-for="Email" class="form-control" type="email" placeholder="an.nguyen@example.com" required />
        <span asp-validation-for="Email" class="field-validation-error"></span>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label asp-for="PhoneNumber" class="form-label">Số điện thoại <span class="required">*</span></label>
        <input asp-for="PhoneNumber" class="form-control" placeholder="0988 123 456" required />
        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label asp-for="Password" class="form-label">Mật khẩu <span class="required">*</span></label>
        <input asp-for="Password" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" required />
        <span asp-validation-for="Password" class="field-validation-error"></span>
      </div>

      <div class="form-group" style="margin-bottom: 20px;">
        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu <span class="required">*</span></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Nhập lại mật khẩu" required />
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
      </div>

      <button type="submit" class="btn-pill btn-pill-primary btn-block btn-pill-lg">
        Đăng ký tài khoản →
      </button>

      <div style="text-align: center; margin-top: 24px; font-size: 0.875rem; color: var(--color-text-secondary);">
        Đã có tài khoản? <a href="/dang-nhap" style="color: var(--color-primary); font-weight: 600;">Đăng nhập ngay</a>
      </div>
    </form>
  </div>
</div>
