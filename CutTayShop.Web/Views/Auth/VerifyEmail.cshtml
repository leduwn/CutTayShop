@{
    ViewData["Title"] = "Xác Minh Email — CutTayShop";
}

<div class="container-custom" style="padding-top: 64px; padding-bottom: 80px; max-width: 520px; text-align: center;">
  <div class="auth-card">
    <div style="font-size: 4rem; line-height: 1; margin-bottom: 16px;">✉️</div>
    <div class="badge-capsule badge-mint" style="margin-bottom: 12px;">Xác minh thành công</div>
    <h1 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 12px;">Email của bạn đã được xác thực!</h1>
    <p style="color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 24px;">
      Cảm ơn bạn đã kích hoạt tài khoản CutTayShop. Bạn đã nhận được mã giảm giá chào mừng <strong>CUTTAYNEW</strong> 20.000đ trong ví voucher.
    </p>

    <div style="display: flex; gap: 12px; justify-content: center;">
      <a href="/tai-khoan" class="btn-pill btn-pill-primary btn-pill-lg">Vào tài khoản của tôi →</a>
      <a href="/san-pham" class="btn-pill btn-pill-secondary btn-pill-lg">Mua sắm ngay</a>
    </div>
  </div>
</div>
