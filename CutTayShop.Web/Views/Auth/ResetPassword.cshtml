@model CutTayShop.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu — CutTayShop";
}

<div class="container-custom" style="padding-top: 48px; padding-bottom: 80px; max-width: 480px;">
  <div class="auth-card">
    <div class="auth-card-header">
      <div class="badge-capsule badge-mint" style="margin-bottom: 12px;">Mật khẩu mới</div>
      <h1 class="auth-title">Thiết lập mật khẩu mới</h1>
      <p class="auth-subtitle">Vui lòng nhập mật khẩu mới an toàn với tối thiểu 6 ký tự.</p>
    </div>

    <form asp-controller="AuthController" asp-action="ResetPassword" method="post">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="Token" />

      <div class="form-group" style="margin-bottom: 16px;">
        <label asp-for="NewPassword" class="form-label">Mật khẩu mới <span class="required">*</span></label>
        <input asp-for="NewPassword" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" required />
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
      </div>

      <div class="form-group" style="margin-bottom: 20px;">
        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới <span class="required">*</span></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Nhập lại mật khẩu" required />
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
      </div>

      <button type="submit" class="btn-pill btn-pill-primary btn-block btn-pill-lg">
        Lưu mật khẩu mới →
      </button>
    </form>
  </div>
</div>
