@model CutTayShop.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên Mật Khẩu — CutTayShop";
}

<div class="container-custom" style="padding-top: 48px; padding-bottom: 80px; max-width: 480px;">
  <div class="auth-card">
    <div class="auth-card-header">
      <div class="badge-capsule badge-sky" style="margin-bottom: 12px;">Khôi phục quyền truy cập</div>
      <h1 class="auth-title">Quên mật khẩu?</h1>
      <p class="auth-subtitle">Nhập email đăng ký của bạn để nhận liên kết đặt lại mật khẩu an toàn.</p>
    </div>

    @if (ViewBag.SuccessMessage != null)
    {
      <div class="alert alert-success" style="margin-bottom: 20px;">
        @ViewBag.SuccessMessage
        @if (ViewBag.DemoResetLink != null)
        {
          <div style="margin-top: 12px;">
            <a href="@ViewBag.DemoResetLink" class="btn-pill btn-pill-primary btn-sm">Bấm vào đây để tiếp tục Demo →</a>
          </div>
        }
      </div>
    }

    <form asp-controller="AuthController" asp-action="ForgotPassword" method="post">
      @Html.AntiForgeryToken()

      <div class="form-group" style="margin-bottom: 20px;">
        <label asp-for="Email" class="form-label">Email tài khoản <span class="required">*</span></label>
        <input asp-for="Email" class="form-control" type="email" placeholder="an.nguyen@example.com" value="an.nguyen@example.com" required />
        <span asp-validation-for="Email" class="field-validation-error"></span>
      </div>

      <button type="submit" class="btn-pill btn-pill-primary btn-block btn-pill-lg">
        Gửi liên kết khôi phục →
      </button>

      <div style="text-align: center; margin-top: 24px; font-size: 0.875rem;">
        <a href="/dang-nhap" style="color: var(--color-text-secondary);">← Quay lại trang đăng nhập</a>
      </div>
    </form>
  </div>
</div>
