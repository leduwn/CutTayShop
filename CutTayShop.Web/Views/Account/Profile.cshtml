@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân — CutTayShop";
}

<div class="container-custom" style="padding-top: 32px; padding-bottom: 80px;">
  <div class="account-portal-layout">
    <div class="account-sidebar-col">
      @await Html.PartialAsync("_AccountNav")
    </div>

    <div class="account-content-col">
      <div class="account-section-card">
        <h1 class="card-title" style="margin-bottom: 8px;">Thông tin hồ sơ cá nhân</h1>
        <p class="text-muted" style="margin-bottom: 24px;">Quản lý thông tin tài khoản để bảo mật và nhận quà sinh nhật từ CutTayShop.</p>

        @if (ViewBag.SuccessMessage != null)
        {
          <div class="alert alert-success" style="margin-bottom: 20px;">
            @ViewBag.SuccessMessage
          </div>
        }

        <form asp-controller="Account" asp-action="Profile" method="post" style="max-width: 600px;">
          @Html.AntiForgeryToken()

          <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Họ và tên</label>
            <input type="text" name="fullName" class="form-control" value="Nguyễn Văn An" required />
          </div>

          <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Số điện thoại</label>
            <input type="tel" name="phone" class="form-control" value="0988 123 456" required />
          </div>

          <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" value="nguyenvanan@gmail.com" required />
          </div>

          <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Ngày sinh</label>
            <input type="date" name="birthday" class="form-control" value="1998-05-15" />
          </div>

          <button type="submit" class="btn-pill btn-pill-primary btn-pill-lg">
            Lưu thay đổi →
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
