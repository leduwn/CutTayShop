@model IReadOnlyList<CutTayShop.Core.Models.Order>
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi — CutTayShop";
    var currentTab = ViewBag.CurrentTab as string ?? "all";
}

<div class="container-custom" style="padding-top: 32px; padding-bottom: 80px;">
  <div class="account-portal-layout">
    <div class="account-sidebar-col">
      @await Html.PartialAsync("_AccountNav")
    </div>

    <div class="account-content-col">
      <div class="account-section-card">
        <h1 class="card-title" style="margin-bottom: 8px;">Đơn hàng của tôi</h1>
        <p class="text-muted" style="margin-bottom: 24px;">Theo dõi và kiểm tra trạng thái toàn bộ đơn hàng bạn đã mua.</p>

        <!-- Filter tabs -->
        <div class="filter-chips-row" style="margin-bottom: 24px;">
          <a href="/tai-khoan/don-hang" class="filter-chip @(currentTab == "all" ? "active" : "")">Tất cả đơn (@Model.Count)</a>
          <a href="/tai-khoan/don-hang?tab=dang-giao" class="filter-chip @(currentTab == "dang-giao" ? "active" : "")">Đang giao</a>
          <a href="/tai-khoan/don-hang?tab=da-giao" class="filter-chip @(currentTab == "da-giao" ? "active" : "")">Đã giao</a>
          <a href="/tai-khoan/don-hang?tab=da-huy" class="filter-chip @(currentTab == "da-huy" ? "active" : "")">Đã hủy</a>
        </div>

        <div class="customer-orders-list" style="display: flex; flex-direction: column; gap: 20px;">
          @foreach (var order in Model)
          {
            <div class="customer-order-card" style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px; background: var(--color-bg-secondary);">
              <div class="order-card-top-bar" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 12px; margin-bottom: 16px;">
                <div>
                  <span style="font-weight: 700;">Đơn hàng #@order.OrderCode</span>
                  <span class="text-muted" style="margin-left: 12px; font-size: 0.8125rem;">Ngày đặt: @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <span class="badge-capsule badge-mint">@order.Status</span>
              </div>

              <!-- Items in order -->
              <div class="order-items-list" style="display: flex; flex-direction: column; gap: 12px;">
                @foreach (var item in order.Items)
                {
                  <div style="display: flex; align-items: center; gap: 16px;">
                    <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 56px; height: 56px; object-fit: cover; border-radius: var(--radius-sm);" />
                    <div style="flex: 1;">
                      <a href="/san-pham/@item.ProductSlug" style="font-weight: 600; color: var(--color-text-primary);">@item.ProductName</a>
                      <div style="font-size: 0.8125rem; color: var(--color-text-secondary);">@item.VariantName • Số lượng: @item.Quantity</div>
                    </div>
                    <div style="font-weight: 600;">@item.TotalPrice.ToString("N0") ₫</div>
                  </div>
                }
              </div>

              <div class="order-card-bottom-bar" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: 16px; margin-top: 16px; flex-wrap: wrap; gap: 12px;">
                <div>
                  <span class="text-muted" style="font-size: 0.875rem;">Tổng thanh toán: </span>
                  <strong style="font-size: 1.125rem; color: var(--color-primary);">@order.TotalAmount.ToString("N0") ₫</strong>
                </div>
                <div style="display: flex; gap: 10px;">
                  <a href="/tra-cuu-don-hang?code=@order.OrderCode" class="btn-pill btn-pill-secondary btn-sm">Theo dõi vận chuyển</a>
                  <a href="/tai-khoan/don-hang/@order.OrderCode" class="btn-pill btn-pill-primary btn-sm">Xem chi tiết đơn</a>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
</div>
