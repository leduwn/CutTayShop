@model CutTayShop.Core.Models.Order
@{
    ViewData["Title"] = "Xử Lý Đơn Hàng #" + Model.OrderCode + " — Admin";
}

<div class="admin-page-header">
  <div>
    <a href="/admin/don-hang" style="font-size: 0.875rem; color: var(--color-primary); font-weight: 600;">← Quay lại danh sách đơn hàng</a>
    <h1 class="admin-page-title" style="margin-top: 8px;">Xử Lý Đơn Hàng: #@Model.OrderCode</h1>
    <span class="text-muted" style="font-size: 0.8125rem;">Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
  </div>
  <div style="display: flex; gap: 10px;">
    <a href="/admin/don-hang/in-phieu/@Model.Id" target="_blank" class="btn-pill btn-pill-secondary">🖨️ In Phiếu Đóng Gói</a>
    <button type="button" class="btn-pill btn-pill-primary" onclick="alert('Đã cập nhật trạng thái đơn hàng thành công!')">Cập nhật trạng thái</button>
  </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-top: 24px;" class="admin-order-split">
  <!-- Left: Order Details & Products -->
  <div style="display: flex; flex-direction: column; gap: 24px;">
    <div class="admin-card" style="padding: 24px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
      <h2 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px;">Sản phẩm đặt mua</h2>
      <table class="table-styled" style="width: 100%;">
        <thead>
          <tr style="text-align: left; background: var(--color-bg-secondary);">
            <th style="padding: 10px;">Sản phẩm</th>
            <th style="padding: 10px;">Đơn giá</th>
            <th style="padding: 10px;">SL</th>
            <th style="padding: 10px; text-align: right;">Thành tiền</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model.Items)
          {
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 10px; display: flex; align-items: center; gap: 10px;">
                <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 44px; height: 44px; object-fit: cover; border-radius: var(--radius-sm);" />
                <div>
                  <strong>@item.ProductName</strong>
                  <div style="font-size: 0.75rem; color: var(--color-text-muted);">@item.VariantName</div>
                </div>
              </td>
              <td style="padding: 10px;">@item.UnitPrice.ToString("N0") ₫</td>
              <td style="padding: 10px;">@item.Quantity</td>
              <td style="padding: 10px; text-align: right; font-weight: 600;">@item.TotalPrice.ToString("N0") ₫</td>
            </tr>
          }
        </tbody>
      </table>

      <div style="max-width: 280px; margin-left: auto; margin-top: 20px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span>Tạm tính:</span>
          <span>@Model.Subtotal.ToString("N0") ₫</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span>Phí ship:</span>
          <span>@Model.ShippingFee.ToString("N0") ₫</span>
        </div>
        <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.125rem; border-top: 1px solid var(--color-border); padding-top: 8px;">
          <span>Tổng thu:</span>
          <span style="color: var(--color-primary);">@Model.TotalAmount.ToString("N0") ₫</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Right: Customer Info & Status Switcher -->
  <div style="display: flex; flex-direction: column; gap: 24px;">
    <div class="admin-card" style="padding: 24px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
      <h2 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px;">Thông tin khách hàng</h2>
      <p style="margin: 0 0 6px;"><strong>@Model.CustomerName</strong></p>
      <p style="margin: 0 0 6px; font-size: 0.875rem;">SĐT: @Model.PhoneNumber</p>
      <p style="margin: 0 0 6px; font-size: 0.875rem;">Email: @Model.Email</p>
      <p style="margin: 0; font-size: 0.875rem; color: var(--color-text-secondary);">Địa chỉ: @Model.ShippingAddress</p>
    </div>

    <div class="admin-card" style="padding: 24px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
      <h2 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px;">Trạng thái đơn hàng</h2>
      <select class="form-control" style="margin-bottom: 16px;">
        <option value="Chờ xác nhận">Chờ xác nhận</option>
        <option value="Đang xử lý">Đang xử lý đóng gói</option>
        <option value="Đang giao" selected>Đang giao cho bưu tá</option>
        <option value="Đã giao">Đã giao thành công</option>
        <option value="Đã hủy">Hủy đơn</option>
      </select>
      <div class="form-group">
        <label class="form-label">Mã vận đơn bưu cục</label>
        <input type="text" class="form-control" value="@(Model.TrackingNumber ?? "VNPOST-99281923")" />
      </div>
    </div>
  </div>
</div>
