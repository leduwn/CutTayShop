@model CutTayShop.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Quản Trị";
}

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">Dashboard Tổng Quan</h1>
    <p class="text-muted">Theo dõi thời gian thực doanh số, đơn hàng và các chỉ số kinh doanh CutTayShop.</p>
  </div>
  <div style="display: flex; gap: 12px;">
    <a href="/admin/san-pham/them-moi" class="btn-pill btn-pill-primary btn-sm">+ Thêm sản phẩm mới</a>
  </div>
</div>

<!-- KPI Cards Grid -->
<div class="admin-kpi-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 24px;">
  <div class="kpi-card" style="padding: 20px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <span class="text-muted" style="font-size: 0.875rem;">DOANH THU HÔM NAY</span>
      <span style="font-size: 1.5rem;">💰</span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 800; color: var(--color-primary); margin: 8px 0 4px;">@Model.TodayRevenue.ToString("N0") ₫</div>
    <span class="badge-capsule badge-mint" style="font-size: 0.75rem;">↑ +18.4% so với hôm qua</span>
  </div>

  <div class="kpi-card" style="padding: 20px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <span class="text-muted" style="font-size: 0.875rem;">ĐƠN HÀNG MỚI</span>
      <span style="font-size: 1.5rem;">📦</span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 800; margin: 8px 0 4px;">@Model.TodayOrders đơn</div>
    <span class="badge-capsule badge-sky" style="font-size: 0.75rem;">3 đơn chờ đóng gói</span>
  </div>

  <div class="kpi-card" style="padding: 20px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <span class="text-muted" style="font-size: 0.875rem;">KHÁCH HÀNG MỚI</span>
      <span style="font-size: 1.5rem;">👥</span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 800; margin: 8px 0 4px;">@Model.TotalCustomers</div>
    <span class="badge-capsule badge-mint" style="font-size: 0.75rem;">↑ +12 tài khoản hôm nay</span>
  </div>

  <div class="kpi-card" style="padding: 20px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <span class="text-muted" style="font-size: 0.875rem;">CẢNH BÁO TỒN KHO</span>
      <span style="font-size: 1.5rem;">⚠️</span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 800; color: var(--color-accent); margin: 8px 0 4px;">@Model.LowStockCount SP</div>
    <a href="/admin/ton-kho" class="badge-capsule badge-peach" style="font-size: 0.75rem;">Xem chi tiết tồn kho →</a>
  </div>
</div>

<!-- Charts & Tables Layout -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-top: 32px;" class="admin-dashboard-split">
  <!-- Left: Recent Orders Table -->
  <div class="admin-card" style="padding: 24px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 1.125rem; font-weight: 700; margin: 0;">Đơn hàng mới nhận</h2>
      <a href="/admin/don-hang" style="font-size: 0.875rem; color: var(--color-primary);">Xem tất cả →</a>
    </div>

    <div style="overflow-x: auto;">
      <table class="table-styled" style="width: 100%;">
        <thead>
          <tr style="text-align: left; background: var(--color-bg-secondary);">
            <th style="padding: 10px;">Mã đơn</th>
            <th style="padding: 10px;">Khách hàng</th>
            <th style="padding: 10px;">Tổng tiền</th>
            <th style="padding: 10px;">Trạng thái</th>
            <th style="padding: 10px;">Xử lý</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var order in Model.RecentOrders)
          {
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 10px;"><strong>#@order.OrderCode</strong></td>
              <td style="padding: 10px;">@order.CustomerName</td>
              <td style="padding: 10px; font-weight: 600;">@order.TotalAmount.ToString("N0") ₫</td>
              <td style="padding: 10px;"><span class="badge-capsule badge-mint">@order.Status</span></td>
              <td style="padding: 10px;">
                <a href="/admin/don-hang/chi-tiet/@order.Id" class="btn-pill btn-pill-secondary btn-sm">Xem</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Right: Top Products Widget -->
  <div class="admin-card" style="padding: 24px; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
    <h2 style="font-size: 1.125rem; font-weight: 700; margin: 0 0 20px;">Sản phẩm bán chạy</h2>
    <div style="display: flex; flex-direction: column; gap: 14px;">
      @foreach (var prod in Model.TopProducts.Take(5))
      {
        <div style="display: flex; align-items: center; gap: 12px;">
          <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 44px; height: 44px; object-fit: cover; border-radius: var(--radius-sm);" />
          <div style="flex: 1; min-width: 0;">
            <div style="font-size: 0.875rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@prod.Name</div>
            <div style="font-size: 0.75rem; color: var(--color-text-secondary);">Đã bán: @prod.SoldCount món</div>
          </div>
          <strong style="font-size: 0.875rem;">@prod.Price.ToString("N0") ₫</strong>
        </div>
      }
    </div>
  </div>
</div>
